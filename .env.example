# 1. Google Gemini API Key (Para 🍌 Nano Banana Pro Image Gen + Guiones KAI 2.5 Flash)
GEMINI_API_KEY=AIzaSy_TU_CLAVE_AQUI

# 2. HuggingFace Serverless Token (Opcional: para black-forest-labs/FLUX.1-schnell)
HF_API_TOKEN=hf_TU_TOKEN_AQUI

# 3. Fal.ai API Key (Opcional: para FLUX.1 + PuLID Facial Consistency)
