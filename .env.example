# Set these in Vercel > Project > Settings > Environment Variables.
# NEVER prefix secret variables with NEXT_PUBLIC_. NEVER commit .env.local.

# Google Gemini API key (server-side only; also supports user-supplied x-mangai-llave header)
GEMINI_API_KEY=
# Optional Gemini model overrides
# GEMINI_KAI_MODEL=gemini-3.1-flash-lite
# GEMINI_CANVAS_IMAGE_MODEL=gemini-3.1-flash-image

# Beta Image Fallback configuration (used automatically if GEMINI_API_KEY is missing or rate-limited)
# Options: pollinations (default), custom, huggingface, cloudflare, local
IMAGE_FALLBACK_PROVIDER=pollinations
# Optional custom HTTP fallback endpoint (POST JSON { prompt, width, height, seed, aspectRatio })
IMAGE_FALLBACK_URL=
# Optional Bearer token for Pollinations.ai (works anonymously without key too)
POLLINATIONS_API_KEY=
# Optional HuggingFace / Cloudflare Workers AI fallback credentials
HF_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=

# Optional private prototype gate (set ENFORCE_STUDIO_TOKEN=true to require x-mangai-access)
STUDIO_ACCESS_TOKEN=
ENFORCE_STUDIO_TOKEN=false

# Optional: Supabase PostgreSQL persistence & Auth (falls back cleanly to Perfil Local / Guest Mode when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Billing / Checkout (Stripe or external Founder Checkout URL)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MASTER=
NEXT_PUBLIC_FOUNDER_CHECKOUT_URL=

# Optional: allow local plan simulation in preview deployments (always enabled in development)
NEXT_PUBLIC_ALLOW_PLAN_SIMULATION=
