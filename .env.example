# 4. Stripe Secret Key (Opcional: activa cobros reales del Pase 72h US$ 2.99 y Pro US$ 19.99)
# Si se deja vacío, /api/checkout opera en modo Sandbox Instantáneo con pases firmados.
STRIPE_SECRET_KEY=sk_live_o_sk_test_AQUI

# 5. Secreto HMAC para firmar los Pases de Estudio de 72 Horas
KAI_PASS_SECRET=kai_flow_studio_rd_2026_secret
