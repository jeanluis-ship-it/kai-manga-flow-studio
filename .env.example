# Set these in Vercel > Project > Settings > Environment Variables.
# NEVER prefix secret variables with NEXT_PUBLIC_. NEVER commit .env.local.
OPENAI_API_KEY=
# gpt-image-2.5-flare = fast creative iterations; sunburst = precision/reference edits.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional: Google Gemini API key for image generation (image models may require paid quota).
GEMINI_API_KEY=
# Optional: authenticated fallback providers (never publish keys in the browser).
HF_API_TOKEN=
POLLINATIONS_API_KEY=
# REQUIRED in this starter: shared private prototype access code (not production auth).
# Choose a long random secret. Enter it in the Studio to enable generation.
STUDIO_ACCESS_TOKEN=
